# Environment --------------------------------------
NODE_ENV=development       # Desenvolvimento
# NODE_ENV=production        # Produção

# PostgreSQL + Docker -----------------------------
DATABASE_URL="postgresql://kanban:kanban_dev@localhost:5432/kanban_db?schema=public"
PORT=3333

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000   # Desenvolvimento (padrão)
# CORS_ORIGIN="https://kanban.app"                         # Produção - único domínio

# JWT (gere secrets seguros: openssl rand -base64 32)
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Password Security (opcional em dev, OBRIGATÓRIO em prod)
# Gere com: openssl rand -base64 32
PASSWORD_PEPPER=

# Rate Limit -----------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
